  m_Script: {fileID: 11500000, guid: 50f03eb7afc416547bd91177cd7c8f8c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  initialDialogue:
  - Hi Adventure. how i can help u ?
  option1Dialogue:
  - well, my name is loriel. im a wizard
  - if you have a item call "skill tablet", you can bring it to me. i will help you
    unlock more powerful skills.
  - the more skills you obtain, the more choice you can choose when playing.
  - same as arcain the alchemist, i wish you luck.
  orbHaveDialogue:
  - oh, well done, adventure. you have the skills tablet.
  - let me solve it for you, adventure...
  orbNotHaveDialogue:
  - i don't see any skills tablet. you can obtain it when defeat some elite enemies.
  - or maybe it can drop by miniboss or boss.
  - you have to find it by yourself, adventure.
  nothingDialogue:
  - oh, then see you soon, adventure
  dialogueUI: {fileID: 708916578}
  dialogueText: {fileID: 747896313}
